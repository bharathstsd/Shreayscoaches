[Unit]
Description=Shreyas Coupons API (gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=__APP__/backend
EnvironmentFile=__APP__/backend/.env
RuntimeDirectory=shreyas-coupons
ExecStart=__APP__/venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/shreyas-coupons/gunicorn.sock --access-logfile - --timeout 60
Restart=always

[Install]
WantedBy=multi-user.target
